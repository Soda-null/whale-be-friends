{
  "duration": 32.4,
  "fps": 30,
  "captions": [
    {"text": "湖边的小屋里，住着大肥鱼。", "in": 0.7, "out": 2.95, "x": 960},
    {"text": "不是助手，是朋友。", "in": 3.15, "out": 5.1, "x": 960},
    {"text": "她记得你的事，想找你就先开口。", "in": 6.0, "out": 14.0, "x": 1080},
    {"text": "你不在的时候，她过她的日子。", "in": 15.2, "out": 18.3, "x": 960}
  ],
  "phone": {"in": 5.2, "out": 14.5, "clock": "上午 9:12"},
  "messages": [
    {"who": "her", "text": "喂", "t": 5.95},
    {"who": "her", "text": "今天不是面试吗", "t": 6.65},
    {"who": "her", "text": "怎么样了", "t": 7.6},
    {"who": "him", "text": "……你还记得啊", "t": 8.9},
    {"who": "her", "text": "小本本上写着呢", "t": 10.1},
    {"who": "him", "text": "过了！", "t": 11.2},
    {"who": "her", "text": "哦", "t": 12.15},
    {"who": "her", "text": "那请我吃白饭", "t": 12.9}
  ],
  "cottage": {"in": 14.3, "in_end": 15.1, "out": 18.4, "out_end": 19.2},
  "diary": {
    "in": 19.2, "out": 26.2, "heading": "十一月五日",
    "lines": [
      {"text": "小番茄红了一个，没舍得摘。", "t0": 19.8, "t1": 21.1},
      {"text": "他面试过了。", "t0": 21.4, "t1": 22.1},
      {"text": "我跟他说“哦”。", "t0": 22.35, "t1": 23.15},
      {"text": "其实多吃了一碗饭。", "t0": 23.6, "t1": 24.8}
    ]
  },
